## Database (Neon Postgres)
## Use the pooled connection string from Neon for serverless/Next.js.
## Ensure sslmode=require.
##
## Recommended params when using Neon pooler (pgbouncer):
## - sslmode=require
## - pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DB?sslmode=require&pgbouncer=true"

## Optional but recommended for Prisma Migrations (direct/non-pooler connection).
## If you don't set this, `prisma migrate dev` may fail against a pooled URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

## Local-only: Neon staging branch (for npm run prisma:migrate:staging / prisma:seed:catalog:staging)
## Never commit real values. Vercel Preview uses DATABASE_URL / DIRECT_URL instead.
# DATABASE_URL_STAGING="postgresql://USER:PASSWORD@POOLER_HOST/DB?sslmode=require&pgbouncer=true"
# DIRECT_URL_STAGING="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

## Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/pl/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/pl/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/pl/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/pl/dashboard"

## AI (OpenAI)
## Used by Trigger.dev worker (local dev reads .env; cloud worker reads Trigger dashboard).
OPENAI_API_KEY="sk-..."

## Background jobs (Trigger.dev v4)
## Two Trigger.dev projects — see docs/architecture/deployment.md

## --- localhost (main Esteo project, Development) ---
## npm run dev + npm run trigger:dev in two terminals
## TRIGGER_PROJECT_ID=proj_<main>
## TRIGGER_SECRET_KEY=tr_dev_...

## --- Vercel Preview / staging branch (Esteo-Staging project) ---
## URL: https://preview.esteo.app (GitHub staging → Vercel Preview). See docs/architecture/deployment.md
## Set in Vercel with Preview checkbox enabled (not Production-only)
## TRIGGER_PROJECT_ID=proj_<staging>
## TRIGGER_SECRET_KEY=tr_prod_...  (Esteo-Staging Production API key)

## --- Vercel Production / main branch (at launch, main Esteo project) ---
## TRIGGER_PROJECT_ID=proj_<main>
## TRIGGER_SECRET_KEY=tr_prod_...  (main Esteo Production API key)

TRIGGER_PROJECT_ID="proj_..."
TRIGGER_SECRET_KEY="tr_..."

PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

## Storage (UploadThing)
UPLOADTHING_TOKEN="eyJ...."
## Upload diagnostics: auto-on in local development only (writes logs/ut-upload-debug.jsonl).
## Disabled on Vercel staging/production. Set UPLOADTHING_UPLOAD_DEBUG=0 to disable locally.
# UPLOADTHING_UPLOAD_DEBUG=0

## Billing (Stripe) — optional for local dev; required for billing flows
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_BUSINESS="price_..."
# STRIPE_PRICE_ADDON_STORAGE="price_..."  # 39 PLN/mo per pack (+10 GB)
# STRIPE_PRICE_ADDON_SEATS="price_..."    # 99 PLN/mo per pack (+5 users, Business only)

## Dev billing toolkit (never set on Vercel Production)
# Enables optional /dev/billing UI outside production. CLI scripts use VERCEL_ENV guard only.
# ENABLE_DEV_BILLING_TOOLS=true

## Issue tracker (staging/dev only — NEVER set on Vercel Production)
# ENABLE_ISSUE_TRACKER=true

## Email (Resend) — estimate send workflow
RESEND_API_KEY="re_..."
## Production / staging (domain must be verified at https://resend.com/domains)
EMAIL_FROM="quotes@mail.esteo.app"
EMAIL_FROM_NAME="Esteo"
## Local dev: Resend sandbox sender (no domain verification). Can only deliver to
## the email address that owns your Resend account unless you verify a domain.
# EMAIL_FROM_DEV="onboarding@resend.dev"
## Redirect all dev outbound mail to your inbox (recommended with sandbox).
## Must be the same email that owns the Resend account (see Resend dashboard).
# EMAIL_DEV_REDIRECT_TO="you@example.com"

## Public estimate form captcha (Cloudflare Turnstile) — optional
## When unset, Turnstile verification is skipped (see src/features/estimate-requests/server/security.ts)
# ESTIMATE_REQUEST_TURNSTILE_SECRET_KEY="..."


APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
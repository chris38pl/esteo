## Database (Neon Postgres)
## Use the pooled connection string from Neon for serverless/Next.js.
## Ensure sslmode=require.
##
## Recommended params when using Neon pooler (pgbouncer):
## - sslmode=require
## - pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DB?sslmode=require&pgbouncer=true"

## Optional but recommended for Prisma Migrations (direct/non-pooler connection).
## If you don't set this, `prisma migrate dev` may fail against a pooled URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

## Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/pl/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/pl/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/pl/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/pl/dashboard"


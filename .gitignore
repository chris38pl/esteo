# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Trigger.dev
.trigger/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/ut-upload-debug.jsonl

# Cursor IDE (ephemeral debug output)
.cursor/debug*.log
.cursor/issue-comments/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Issue tracker sync output (local Cursor context)
/docs/issues/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

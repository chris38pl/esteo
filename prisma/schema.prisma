generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELED
  INACTIVE
}

enum WorkspaceRole {
  OWNER
  MEMBER
  VIEWER
}

enum InviteRole {
  MEMBER
  VIEWER
}

enum WorkspaceRuleType {
  ESTIMATE
  COMMUNICATION
  CUSTOM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
  DECLINED
}

enum WorkspaceLocale {
  PL
  EN
}

enum EstimateRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WorkspaceIndustry {
  CONSTRUCTION
  ELECTRICAL
  CARPENTRY
  PLUMBING
  OTHER
}

enum WorkspaceAppearanceTheme {
  OCEAN_BREEZE
  FOREST_MIST
  SUNRISE_PEAK
  GREEN_VALLEY
}

enum BusinessDocumentType {
  ESTIMATE_REQUEST
  ESTIMATE
}

enum IndustryFieldValueType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum EstimateVersionStatus {
  DRAFT
  SENT
  ARCHIVED
}

enum EstimateAiMessageRole {
  USER
  ASSISTANT
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  clerkId               String       @unique
  name                  String?
  avatarUrl             String?
  platformRole          PlatformRole @default(NONE)
  lastActiveWorkspaceId String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  billingAccount       BillingAccount?
  lastActiveWorkspace  Workspace?            @relation("UserLastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id], onDelete: SetNull)
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[] @relation("InvitationSender")
  memberInvites        WorkspaceMember[]     @relation("MemberInvitedBy")
  auditLogs            AuditLog[]
  pinnedEstimates      PinnedEstimate[]
}

model BillingAccount {
  id               String   @id @default(cuid())
  ownerUserId      String   @unique
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner   User                        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  subscription Subscription?
  workspaces   Workspace[]
  usagePeriods BillingAccountUsagePeriod[]
}

model Subscription {
  id                   String             @id @default(cuid())
  billingAccountId     String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  /// MVP: FREE plans use ACTIVE. ACTIVE = usable subscription state, not necessarily paid.
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
}

model Workspace {
  id               String          @id @default(cuid())
  billingAccountId String
  ownerId          String
  name              String
  slug              String           @unique
  industry          WorkspaceIndustry
  industryOtherText String?
  defaultLocale     WorkspaceLocale  @default(PL)
  appearanceTheme   WorkspaceAppearanceTheme @default(OCEAN_BREEZE)
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  billingAccount   BillingAccount    @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members          WorkspaceMember[]
  invitations      WorkspaceInvitation[]
  settings         WorkspaceSettings?
  rules            WorkspaceRule[]
  estimateRequests EstimateRequest[]
  estimates        Estimate[]
  estimateVersions  EstimateVersion[]
  estimateSections  EstimateSection[]
  estimateLineItems EstimateLineItem[]
  estimateRevisions EstimateRevision[]
  auditLogs           AuditLog[]
  lastActiveUsers     User[]              @relation("UserLastActiveWorkspace")
  documentFieldValues DocumentFieldValue[]
  slugAliases         WorkspaceSlugAlias[]
  pinnedEstimates     PinnedEstimate[]

  @@index([billingAccountId])
  @@index([ownerId])
  @@index([deletedAt])
}

model WorkspaceSlugAlias {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceSettings {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  branding           Json?
  aiInstructions     String?
  companyDescription String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceRule {
  id          String            @id @default(cuid())
  workspaceId String
  type        WorkspaceRuleType
  locale      WorkspaceLocale?
  title       String
  content     String
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active, sortOrder])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  invitedById String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        InviteRole
  token       String           @unique
  invitedById String
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  promptDismissedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email, status])
}

model BillingAccountUsagePeriod {
  id                 String   @id @default(cuid())
  billingAccountId   String
  periodKey          String
  estimatesCreated   Int      @default(0)
  aiAssistantCalls   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, periodKey])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  workspaceId String?
  entityType  String
  entityId    String
  action      String
  diff        Json?
  createdAt   DateTime @default(now())

  actor     User       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  stripeEventId String @unique
  type        String
  processedAt DateTime @default(now())
}

model EstimateRequest {
  id                 String                @id @default(cuid())
  workspaceId        String
  requestNumber      String?
  status             EstimateRequestStatus @default(PENDING)
  customerData       Json?
  address            Json?
  projectDescription String
  attachments        Json?
  aiMetadata         Json?
  estimateId         String?               @unique
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  estimate  Estimate? @relation("EstimateRequestEstimate", fields: [estimateId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, requestNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
}

model Estimate {
  id              String    @id @default(cuid())
  workspaceId     String
  title           String?
  aiMetadata      Json?
  currency        String    @default("PLN")
  latestVersionId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  estimateRequest EstimateRequest?  @relation("EstimateRequestEstimate")
  versions        EstimateVersion[] @relation("EstimateVersions")
  latestVersion   EstimateVersion?  @relation("EstimateLatestVersion", fields: [latestVersionId], references: [id], onDelete: SetNull)
  pinnedBy        PinnedEstimate[]

  @@index([workspaceId])
}

model PinnedEstimate {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  estimateId  String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  estimate  Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, estimateId])
  @@index([userId, workspaceId, sortOrder])
}

model EstimateVersion {
  id              String                @id @default(cuid())
  estimateId      String
  workspaceId     String
  versionNumber   Int
  status          EstimateVersionStatus @default(DRAFT)
  marginPercent   Decimal               @default(0)
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  estimate  Estimate          @relation("EstimateVersions", fields: [estimateId], references: [id], onDelete: Cascade)
  latestOf  Estimate[]        @relation("EstimateLatestVersion")
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections   EstimateSection[]
  revisions  EstimateRevision[]
  aiMessages EstimateAiMessage[]

  @@unique([estimateId, versionNumber])
  @@index([estimateId])
  @@index([workspaceId])
}

model EstimateSection {
  id          String    @id @default(cuid())
  workspaceId String
  versionId   String
  title       String
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  version   EstimateVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lineItems EstimateLineItem[]

  @@index([versionId, sortOrder])
  @@index([workspaceId])
}

model EstimateLineItem {
  id          String    @id @default(cuid())
  workspaceId String
  sectionId   String
  name        String
  unit        String?
  quantity    Decimal   @default(0)
  unitPrice   Decimal   @default(0)
  vatRate     Decimal   @default(0)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  section   EstimateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
  @@index([workspaceId])
}

model EstimateRevision {
  id              String   @id @default(cuid())
  versionId       String
  workspaceId     String
  snapshotJson    Json
  source          String
  createdByUserId String
  createdAt       DateTime @default(now())

  version   EstimateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
  @@index([workspaceId])
}

/// Append-only AI assistant conversation log per estimate version (immutable).
model EstimateAiMessage {
  id           String                @id @default(cuid())
  versionId    String
  role         EstimateAiMessageRole
  content      String                @db.Text
  proposalJson Json?
  createdAt    DateTime              @default(now())

  version EstimateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
}

model IndustryFieldDefinition {
  id           String                 @id @default(cuid())
  industry     WorkspaceIndustry
  documentType BusinessDocumentType
  key          String
  valueType    IndustryFieldValueType
  sortOrder    Int                    @default(0)
  required     Boolean                @default(false)
  options      Json?
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  translations IndustryFieldTranslation[]

  @@unique([industry, documentType, key])
  @@index([industry, documentType, active])
}

model IndustryFieldTranslation {
  id          String          @id @default(cuid())
  fieldId     String
  locale      WorkspaceLocale
  label       String
  description String?
  placeholder String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  field IndustryFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, locale])
}

model DocumentFieldValue {
  id           String               @id @default(cuid())
  workspaceId  String
  documentType BusinessDocumentType
  documentId   String
  fieldKey     String
  valueText    String?
  valueNumber  Decimal?             @db.Decimal(18, 4)
  valueDate    DateTime?            @db.Date
  valueBoolean Boolean?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([documentType, documentId, fieldKey])
  @@index([workspaceId, documentType, documentId])
  @@index([documentType, fieldKey, valueNumber])
}

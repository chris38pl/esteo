generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
  QA_TESTER
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionChangeType {
  PLAN_DOWNGRADE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELED
  INACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
}

enum AddonKey {
  STORAGE
  SEATS
  CLIENT_PORTAL
  API_ACCESS
  WHITE_LABEL
  AI_PACK
}

enum AddonStatus {
  ACTIVE
  SCHEDULED_REMOVAL
  CANCELED
}

/// Membership state machine (separate from WorkspaceRole). Pending users live in WorkspaceInvitation.
enum WorkspaceMemberState {
  ACTIVE
  SUSPENDED
  REMOVED
}

/// Why a membership was suspended/removed — drives reactivation logic and messaging.
enum WorkspaceMemberSuspendedReason {
  SEAT_OVERAGE
  UNPAID
  ADMIN
}

/// Voluntary/involuntary workspace lifecycle flags layered on top of the derived effective status.
enum WorkspaceProvisioningStatus {
  /// Paid workspace awaiting first successful checkout (webhook activates it).
  INCOMPLETE
  ACTIVE
}

/// Generic usage meter key. Adding a new metered feature = new value, no schema change.
enum UsageMeter {
  ESTIMATE_CREATED
  AI_ASSISTANT_CALL
}

enum WorkspaceRole {
  OWNER
  MEMBER
  VIEWER
}

enum InviteRole {
  MEMBER
  VIEWER
}

enum WorkspaceRuleType {
  ESTIMATE
  COMMUNICATION
  CUSTOM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
  DECLINED
  /// Seat unavailable after a downgrade; re-activatable on upgrade.
  ON_HOLD
}

enum WorkspaceOwnershipTransferStatus {
  PENDING_RECIPIENT
  COMPLETED
  CANCELLED
  EXPIRED
}

enum WorkspaceLocale {
  PL
  EN
}

enum EstimateRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WorkspaceIndustry {
  CONSTRUCTION
  ELECTRICAL
  CARPENTRY
  PLUMBING
  OTHER
}

enum WorkspaceAppearanceTheme {
  OCEAN_BREEZE
  FOREST_MIST
  SUNRISE_PEAK
  GREEN_VALLEY
}

enum BusinessDocumentType {
  ESTIMATE_REQUEST
  ESTIMATE
}

enum IndustryFieldValueType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum EstimateVersionStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum EstimateSendTransportStatus {
  QUEUED
  GENERATING_PDF
  SENDING
  PROVIDER_ACCEPTED
  DELIVERED
  BOUNCED
  FAILED
}

enum EstimateActivityCategory {
  ESTIMATE
  VERSION
  FINANCIAL
  AI
  SHARING
}

enum EstimateActivityActorType {
  USER
  SYSTEM
}

enum EstimateAiMessageRole {
  USER
  ASSISTANT
}

enum AvatarSource {
  CLERK
  PRESET
}

enum StorageProvider {
  UPLOADTHING
}

enum AttachmentType {
  IMAGE
  PDF
  DOCX
}

enum AttachmentUploadSource {
  EDITOR
  PUBLIC_REQUEST
  INTERNAL_REQUEST
}

enum AttachmentThumbnailStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSING
  GENERATED
  FAILED
}

model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  clerkId               String       @unique
  name                  String?
  avatarUrl             String?
  avatarPreset          String?
  avatarSource          AvatarSource @default(PRESET)
  platformRole          PlatformRole @default(NONE)
  lastActiveWorkspaceId String?
  deletedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  billingAccounts      BillingAccount[]      @relation("BillingAccountOwner")
  payerBillingAccounts BillingAccount[]      @relation("BillingAccountPayer")
  billingCustomers     BillingCustomer[]
  usageEvents          UsageEvent[]
  lastActiveWorkspace  Workspace?            @relation("UserLastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id], onDelete: SetNull)
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[] @relation("InvitationSender")
  sentOwnershipTransfers WorkspaceOwnershipTransfer[] @relation("TransferSender")
  receivedOwnershipTransfers WorkspaceOwnershipTransfer[] @relation("TransferRecipient")
  memberInvites        WorkspaceMember[]     @relation("MemberInvitedBy")
  auditLogs            AuditLog[]
  pinnedEstimates      PinnedEstimate[]
  estimateNotes        EstimateNote[]
  estimateActivityLogs EstimateActivityLog[]
  estimateAttachments  EstimateAttachment[]
  estimatePdfs         EstimatePdf[]
  estimateVersionSends EstimateVersionSend[]
  estimateVersionsLastSent EstimateVersion[] @relation("EstimateVersionLastSentBy")
  estimateVersionsAccepted EstimateVersion[] @relation("EstimateVersionAcceptedBy")
  estimateVersionsRejected EstimateVersion[] @relation("EstimateVersionRejectedBy")
  reportedIssues       Issue[]
  recentDocuments      UserRecentDocument[]

  @@index([deletedAt])
}

enum SearchEntityType {
  ESTIMATE
  INQUIRY
  ATTACHMENT
}

enum SearchIconType {
  ESTIMATE
  REQUEST
  FILE
}

enum IssueType {
  BUG
  UX
  FEATURE
  AI_EXTRACTION
  PERFORMANCE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum IssueEnvironment {
  LOCALHOST
  PREVIEW
  PRODUCTION
}

enum IssueDeviceType {
  MOBILE
  TABLET
  DESKTOP
}

model IssueNumberCounter {
  id    String @id @default("default")
  value Int    @default(0)
}

model Issue {
  id                String            @id @default(cuid())
  number            Int               @unique
  folderSlug        String
  type              IssueType
  priority          IssuePriority     @default(MEDIUM)
  status            IssueStatus       @default(OPEN)
  title             String
  description       String            @db.Text
  reproductionSteps String?           @db.Text
  expectedBehavior  String?           @db.Text
  actualBehavior    String?           @db.Text
  pageUrl           String
  context           Json?
  locale            String
  userAgent         String            @db.Text
  deviceType        IssueDeviceType
  viewportWidth     Int
  viewportHeight    Int
  environment       IssueEnvironment
  fixedIn           String?
  reportedById      String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  reportedBy  User              @relation(fields: [reportedById], references: [id], onDelete: Restrict)
  attachments IssueAttachment[]

  @@index([status, createdAt])
  @@index([number])
}

model IssueAttachment {
  id               String   @id @default(cuid())
  issueId          String
  storageKey       String
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, sortOrder])
}

/// Canonical billing entity. Target model: 1:1 with Workspace (workspaceId @unique).
/// `ownerUserId` is a denormalized helper for owner/FREE-rule queries (NOT unique any more).
/// `payerUserId` separates the billing payer from the workspace owner.
/// `workspaces` (legacy 1:N) is retained during the migration; new code keys on `workspace`.
model BillingAccount {
  id                String   @id @default(cuid())
  ownerUserId       String
  payerUserId       String?
  workspaceId       String?  @unique
  billingCustomerId String?
  /// Set when subscription EXPIRED during billing handoff (owner !== payer). 90-day timeout is derived from this.
  handoffExpiredAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner           User                        @relation("BillingAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  payer           User?                       @relation("BillingAccountPayer", fields: [payerUserId], references: [id], onDelete: SetNull)
  workspace       Workspace?                  @relation("WorkspaceBillingAccount", fields: [workspaceId], references: [id], onDelete: Cascade)
  billingCustomer BillingCustomer?            @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  subscription    Subscription?
  workspaces      Workspace[]                 @relation("WorkspaceLegacyBillingAccount")
  usagePeriods    BillingAccountUsagePeriod[]

  @@index([ownerUserId])
  @@index([billingCustomerId])
}

/// Names a Stripe customer. V1: at most one per ownerUserId (enforced in BillingService).
/// Future customer-per-workspace = split rows + repoint BillingAccount.billingCustomerId. No domain change.
model BillingCustomer {
  id               String   @id @default(cuid())
  ownerUserId      String
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner           User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  billingAccounts BillingAccount[]

  @@index([ownerUserId])
}

model Subscription {
  id                   String             @id @default(cuid())
  billingAccountId     String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  /// Pinned entitlement catalog version (e.g. PRO_2026). Null = current/default for the plan.
  planVersion          String?
  /// MVP: FREE plans use ACTIVE. ACTIVE = usable subscription state, not necessarily paid.
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  cancelAtPeriodEnd    Boolean            @default(false)
  currentPeriodEnd     DateTime?
  graceEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  changes          SubscriptionChange[]
}

model SubscriptionChange {
  id                String                 @id @default(cuid())
  subscriptionId    String
  type              SubscriptionChangeType
  targetPlan        SubscriptionPlan?
  targetPlanVersion String?
  effectiveAt       DateTime
  createdAt         DateTime               @default(now())
  canceledAt        DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, canceledAt])
  @@index([subscriptionId, effectiveAt])
}

/// Paid add-on capacity synced from Stripe subscription item quantities.
model WorkspaceAddon {
  id                       String      @id @default(cuid())
  workspaceId              String
  addonKey                 AddonKey
  /// Number of packs on the Stripe subscription item. Entitlement = quantity × unit size from addon-catalog.
  quantity                 Int         @default(0)
  status                   AddonStatus @default(ACTIVE)
  stripeSubscriptionItemId String?     @unique
  stripePriceId            String?
  effectiveUntil           DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, addonKey])
  @@index([workspaceId, status])
}

model Workspace {
  id                          String                      @id @default(cuid())
  billingAccountId            String
  ownerId                     String
  name                        String
  slug                        String                      @unique
  slugIsCustom                Boolean                     @default(false)
  industry                    WorkspaceIndustry
  industryOtherText           String?
  defaultLocale               WorkspaceLocale             @default(PL)
  appearanceTheme             WorkspaceAppearanceTheme    @default(OCEAN_BREEZE)
  attachmentStorageUsedBytes  BigInt                      @default(0)
  attachmentStorageLimitBytes BigInt                      @default(262144000)
  /// True when this is the owner's single active FREE workspace. Backed by a partial unique index.
  isActiveFree                Boolean                     @default(false)
  provisioningStatus          WorkspaceProvisioningStatus @default(ACTIVE)
  /// Voluntary end-state (owner archived). Distinct from involuntary EXPIRED and from soft-delete.
  archivedAt                  DateTime?
  /// Platform/admin hold (ToS/fraud) — overrides billing state in the effective-status resolver.
  platformSuspendedAt         DateTime?
  deletedAt                   DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  billingAccount       BillingAccount         @relation("WorkspaceLegacyBillingAccount", fields: [billingAccountId], references: [id], onDelete: Restrict)
  ownBillingAccount    BillingAccount?        @relation("WorkspaceBillingAccount")
  owner                User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  usageEvents          UsageEvent[]
  usageAggregates      UsagePeriodAggregate[]
  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  ownershipTransfers   WorkspaceOwnershipTransfer[]
  settings             WorkspaceSettings?
  rules                WorkspaceRule[]
  estimateRequests     EstimateRequest[]
  estimates            Estimate[]
  estimateVersions     EstimateVersion[]
  estimateSections     EstimateSection[]
  estimateLineItems    EstimateLineItem[]
  estimateRevisions    EstimateRevision[]
  estimateActivityLogs EstimateActivityLog[]
  auditLogs            AuditLog[]
  lastActiveUsers      User[]                 @relation("UserLastActiveWorkspace")
  documentFieldValues  DocumentFieldValue[]
  slugAliases          WorkspaceSlugAlias[]
  pinnedEstimates      PinnedEstimate[]
  estimateAttachments  EstimateAttachment[]
  estimateVersionSends EstimateVersionSend[]
  workspaceAddons      WorkspaceAddon[]
  searchDocuments      SearchDocument[]
  recentDocuments      UserRecentDocument[]

  @@index([billingAccountId])
  @@index([ownerId])
  @@index([deletedAt])
}

model WorkspaceSlugAlias {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceSettings {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  branding           Json?
  aiInstructions     String?
  companyDescription String?
  companyAddress     String?
  companyTaxId       String?
  companyEmail       String?
  companyPhone       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceRule {
  id          String            @id @default(cuid())
  workspaceId String
  type        WorkspaceRuleType
  locale      WorkspaceLocale?
  title       String
  content     String
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active, sortOrder])
}

model WorkspaceMember {
  id              String                          @id @default(cuid())
  workspaceId     String
  userId          String
  role            WorkspaceRole                   @default(MEMBER)
  state           WorkspaceMemberState            @default(ACTIVE)
  suspendedReason WorkspaceMemberSuspendedReason?
  suspendedAt     DateTime?
  invitedById     String?
  deletedAt       DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id                String           @id @default(cuid())
  workspaceId       String
  email             String
  role              InviteRole
  token             String           @unique
  invitedById       String
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  promptDismissedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email, status])
}

model WorkspaceOwnershipTransfer {
  id                 String                           @id @default(cuid())
  workspaceId        String
  fromUserId         String
  toEmail            String
  toUserId           String?
  token              String                           @unique
  status             WorkspaceOwnershipTransferStatus @default(PENDING_RECIPIENT)
  planSnapshot       SubscriptionPlan
  periodEndSnapshot  DateTime
  keepSenderAsMember Boolean                          @default(true)
  expiresAt          DateTime
  acceptedAt         DateTime?
  cancelledAt        DateTime?
  promptDismissedAt  DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUser  User      @relation("TransferSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User?     @relation("TransferRecipient", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([toEmail, status])
  @@index([toUserId, status])
}

model BillingAccountUsagePeriod {
  id               String   @id @default(cuid())
  billingAccountId String
  periodKey        String
  estimatesCreated Int      @default(0)
  aiAssistantCalls Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, periodKey])
}

/// Append-only usage log (attribution, audit, re-aggregation, future metered billing).
model UsageEvent {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String?
  meter       UsageMeter
  quantity    Int        @default(1)
  occurredAt  DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, meter, occurredAt])
  @@index([workspaceId, userId, meter, occurredAt])
}

/// Hot-path aggregate per workspace/meter/period. `userId` = "" is the workspace total;
/// a non-empty userId is per-member attribution. Sentinel avoids NULLs in the unique key.
model UsagePeriodAggregate {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String     @default("")
  meter       UsageMeter
  periodKey   String
  quantity    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, meter, periodKey])
  @@index([workspaceId, meter, periodKey])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  workspaceId String?
  entityType  String
  entityId    String
  action      String
  diff        Json?
  createdAt   DateTime @default(now())

  actor     User       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

model EstimateRequest {
  id                 String                @id @default(cuid())
  workspaceId        String
  requestNumber      String?
  status             EstimateRequestStatus @default(PENDING)
  customerData       Json?
  address            Json?
  projectDescription String
  attachments        Json?
  aiMetadata         Json?
  estimateId         String?               @unique
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  estimate  Estimate? @relation("EstimateRequestEstimate", fields: [estimateId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, requestNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
}

model Estimate {
  id              String    @id @default(cuid())
  workspaceId     String
  title           String?
  aiMetadata      Json?
  currency        String    @default("PLN")
  attachmentCount Int       @default(0)
  latestVersionId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  estimateRequest     EstimateRequest?      @relation("EstimateRequestEstimate")
  versions            EstimateVersion[]     @relation("EstimateVersions")
  latestVersion       EstimateVersion?      @relation("EstimateLatestVersion", fields: [latestVersionId], references: [id], onDelete: SetNull)
  pinnedBy            PinnedEstimate[]
  notes               EstimateNote[]
  activityLogs        EstimateActivityLog[]
  paymentInstallments PaymentInstallment[]
  attachments         EstimateAttachment[]
  pdfs                EstimatePdf[]

  @@index([workspaceId])
}

enum EstimatePdfStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model EstimatePdf {
  id                  String            @id @default(cuid())
  estimateId          String
  versionId           String
  fileKey             String?
  storageCustomId     String?
  status              EstimatePdfStatus @default(PENDING)
  errorMessage        String?
  generatedAt         DateTime          @default(now())
  generatedLocale     String?
  pdfTemplateRevision Int?
  createdById         String?

  estimate  Estimate        @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  version   EstimateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sends     EstimateVersionSend[]

  @@unique([versionId])
  @@index([estimateId])
}

model EstimateAttachment {
  id                       String                    @id @default(cuid())
  estimateId               String
  workspaceId              String
  uploadedById             String?
  uploadSource             AttachmentUploadSource    @default(EDITOR)
  attachmentType           AttachmentType
  originalFileName         String
  mimeType                 String
  /// Stored bytes: original at ingest; incremented by thumbnail bytes after async generation
  fileSizeBytes            BigInt
  storageKey               String
  storageProvider          StorageProvider           @default(UPLOADTHING)
  imageWidth               Int?
  imageHeight              Int?
  thumbnailStorageKey      String?
  thumbnailStatus          AttachmentThumbnailStatus @default(NOT_APPLICABLE)
  thumbnailGenerationError String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  estimate   Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([estimateId, createdAt])
  @@index([workspaceId])
}

model PaymentInstallment {
  id         String    @id @default(cuid())
  estimateId String
  name       String
  amount     Decimal   @db.Decimal(12, 2)
  paidAmount Decimal   @default(0) @db.Decimal(12, 2)
  dueDate    DateTime? @db.Date
  paidAt     DateTime?
  note       String?   @db.Text
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, sortOrder])
}

model EstimateActivityLog {
  id          String                    @id @default(cuid())
  estimateId  String
  workspaceId String
  actorType   EstimateActivityActorType @default(USER)
  actorUserId String?
  category    EstimateActivityCategory
  action      String
  metadata    Json?
  occurredAt  DateTime                  @default(now())
  createdAt   DateTime                  @default(now())

  estimate  Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([estimateId, occurredAt])
  @@index([estimateId, action, actorType, actorUserId, occurredAt])
}

model PinnedEstimate {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  estimateId  String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  estimate  Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, estimateId])
  @@index([userId, workspaceId, sortOrder])
}

model EstimateVersion {
  id                String                @id @default(cuid())
  estimateId        String
  workspaceId       String
  versionNumber     Int
  status            EstimateVersionStatus @default(DRAFT)
  statusChangedAt   DateTime              @default(now())
  archivedAt        DateTime?
  lastSentAt        DateTime?
  lastSentToEmail   String?
  lastSentByUserId  String?
  acceptedAt        DateTime?
  acceptedByUserId  String?
  rejectedAt        DateTime?
  rejectedByUserId  String?
  marginPercent     Decimal               @default(0)
  totalNet          Decimal               @default(0)
  totalGross        Decimal               @default(0)
  createdByUserId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  estimate   Estimate              @relation("EstimateVersions", fields: [estimateId], references: [id], onDelete: Cascade)
  latestOf   Estimate[]            @relation("EstimateLatestVersion")
  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastSentBy User?                 @relation("EstimateVersionLastSentBy", fields: [lastSentByUserId], references: [id], onDelete: SetNull)
  acceptedBy User?                 @relation("EstimateVersionAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  rejectedBy User?                 @relation("EstimateVersionRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  sections   EstimateSection[]
  revisions  EstimateRevision[]
  aiMessages EstimateAiMessage[]
  pdf        EstimatePdf?
  sends      EstimateVersionSend[]

  @@unique([estimateId, versionNumber])
  @@index([estimateId])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

model EstimateVersionSend {
  id               String                      @id @default(cuid())
  versionId        String
  workspaceId      String
  sentToEmail      String
  deliveredToEmail String?
  replyToEmail     String
  sentByUserId     String
  sentAt           DateTime?
  transportStatus  EstimateSendTransportStatus @default(QUEUED)
  errorMessage     String?
  emailSubject     String
  emailHtml        String?                     @db.Text
  attachPdf        Boolean                     @default(true)
  estimatePdfId    String?
  resendMessageId  String?
  triggerRunId     String?
  isResend         Boolean                     @default(false)
  createdAt        DateTime                    @default(now())

  version  EstimateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sentBy   User             @relation(fields: [sentByUserId], references: [id], onDelete: Restrict)
  pdf      EstimatePdf?     @relation(fields: [estimatePdfId], references: [id], onDelete: SetNull)

  @@index([versionId, sentAt(sort: Desc)])
  @@index([workspaceId])
}

model EstimateSection {
  id          String    @id @default(cuid())
  workspaceId String
  versionId   String
  title       String
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  version   EstimateVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lineItems EstimateLineItem[]

  @@index([versionId, sortOrder])
  @@index([workspaceId])
}

model EstimateLineItem {
  id          String    @id @default(cuid())
  workspaceId String
  sectionId   String
  name        String
  unit        String?
  quantity    Decimal   @default(0)
  unitPrice   Decimal   @default(0)
  vatRate     Decimal   @default(0)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  section   EstimateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
  @@index([workspaceId])
}

model EstimateRevision {
  id              String   @id @default(cuid())
  versionId       String
  workspaceId     String
  snapshotJson    Json
  source          String
  createdByUserId String
  createdAt       DateTime @default(now())

  version   EstimateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
  @@index([workspaceId])
}

/// Append-only AI assistant conversation log per estimate version (immutable).
model EstimateAiMessage {
  id           String                @id @default(cuid())
  versionId    String
  role         EstimateAiMessageRole
  content      String                @db.Text
  proposalJson Json?
  createdAt    DateTime              @default(now())

  version EstimateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
}

/// Internal threaded notes on an estimate (top-level + one-level replies).
model EstimateNote {
  id           String   @id @default(cuid())
  estimateId   String
  parentId     String?
  authorUserId String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  estimate Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  parent   EstimateNote?  @relation("EstimateNoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  EstimateNote[] @relation("EstimateNoteReplies")
  author   User           @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([estimateId, createdAt])
  @@index([parentId])
}

model IndustryFieldDefinition {
  id           String                 @id @default(cuid())
  industry     WorkspaceIndustry
  documentType BusinessDocumentType
  key          String
  valueType    IndustryFieldValueType
  sortOrder    Int                    @default(0)
  required     Boolean                @default(false)
  options      Json?
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  translations IndustryFieldTranslation[]

  @@unique([industry, documentType, key])
  @@index([industry, documentType, active])
}

model IndustryFieldTranslation {
  id          String          @id @default(cuid())
  fieldId     String
  locale      WorkspaceLocale
  label       String
  description String?
  placeholder String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  field IndustryFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, locale])
}

model DocumentFieldValue {
  id           String               @id @default(cuid())
  workspaceId  String
  documentType BusinessDocumentType
  documentId   String
  fieldKey     String
  valueText    String?
  valueNumber  Decimal?             @db.Decimal(18, 4)
  valueDate    DateTime?            @db.Date
  valueBoolean Boolean?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([documentType, documentId, fieldKey])
  @@index([workspaceId, documentType, documentId])
  @@index([documentType, fieldKey, valueNumber])
}

model SearchDocument {
  id                    String           @id @default(cuid())
  workspaceId           String
  workspaceSlugSnapshot String?
  entityType            SearchEntityType
  entityId              String
  iconType              SearchIconType
  title                 String
  subtitle              String?
  searchText            String           @db.Text
  url                   String
  metadata              Json?
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityType, entityId])
  @@index([workspaceId, deletedAt])
}

model UserRecentDocument {
  id               String           @id @default(cuid())
  userId           String
  workspaceId      String
  entityType       SearchEntityType
  entityId         String
  titleSnapshot    String
  subtitleSnapshot String?
  iconTypeSnapshot SearchIconType
  lastOpenedAt     DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, entityType, entityId])
  @@index([userId, workspaceId, lastOpenedAt(sort: Desc)])
}
